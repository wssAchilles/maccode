REDIS_URL=rediss://default:token@host:6379
APP_ENV=development
CORS_ALLOW_ORIGINS=*
MARKET_CHANNEL=md.orderbook.BTCUSDT
MARKET_CHANNELS=md.orderbook.BTCUSDT,md.orderbook.ETHUSDT
MARKET_STREAM_ENABLED=true
MARKET_STREAM_KEY=cerberus.market.events
MARKET_STREAM_CONSUMER_GROUP=strategy-market
MARKET_STREAM_CONSUMER_NAME=
MARKET_STREAM_READ_BATCH_SIZE=64
MARKET_STREAM_READ_BLOCK_MS=3000
MARKET_STREAM_PENDING_REPLAY_COUNT=128
MARKET_STREAM_BATCH_WINDOW_MS=100
MARKET_STREAM_MAX_RETRIES_BEFORE_FALLBACK=6
MARKET_STREAM_RETRY_BACKOFF_MS=200
MARKET_STREAM_RETRY_BACKOFF_MAX_MS=5000
MARKET_STREAM_LEGACY_PUBSUB_FALLBACK=true
SIGNAL_CHANNEL=strategy.signals.default
FAST_WINDOW=5
SLOW_WINDOW=20

# Gurobi WLS (do not commit real values)
GRB_LICENSEID=
GRB_WLSACCESSID=
GRB_WLSSECRET=

# Optional Firebase signal persistence
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=cerberus-9d94f
FIREBASE_SIGNAL_COLLECTION=strategy_signals
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_ENABLED=false
SUPABASE_SIGNAL_TABLE=strategy_signals
SUPABASE_TIMEOUT_SECONDS=5
SIGNAL_HISTORY_LIMIT_DEFAULT=20
SIGNAL_HISTORY_LIMIT_MAX=200

# Optional matching gRPC submit path
MATCHING_ENABLED=false
MATCHING_GRPC_TARGET=localhost:50051
# Cloud Run example:
# MATCHING_GRPC_TARGET=https://cerberus-dev-matching-xxxxx-uc.a.run.app
MATCHING_GRPC_TIMEOUT_SECONDS=2
STRATEGY_ACCOUNT_ID=default
STRATEGY_ORDER_QUANTITY=0.001
TRADE_EXECUTION_CHANNEL_PREFIX=trade.executions
EXECUTION_RELAY_INTERVAL_SECONDS=1
EXECUTION_RELAY_BATCH_LIMIT=100
EVENT_SCHEMA_VERSION=v1
IDEMPOTENCY_STORE_REDIS_ENABLED=true
IDEMPOTENCY_REDIS_KEY_PREFIX=cerberus:idempotency
SIGNAL_IDEMPOTENCY_TTL_SECONDS=900
IDEMPOTENCY_MAX_ENTRIES=20000
RETRIABLE_BASE_BACKOFF_SECONDS=0.2
RETRIABLE_MAX_BACKOFF_SECONDS=5
