project_id  = "cerberus-9d94f"
region      = "asia-east2"
environment = "dev"

# Replace with valid values via secure channel, then keep terraform.tfvars out of Git.
gurobi_licenseid   = ""
gurobi_wlsaccessid = ""
gurobi_wlssecret   = ""

upstash_redis_url        = ""
upstash_redis_rest_url   = ""
upstash_redis_rest_token = ""

supabase_project_url      = ""
supabase_anon_key         = ""
supabase_service_role_key = ""
supabase_db_url           = ""

firebase_web_api_key    = ""
binance_api_key         = ""
binance_api_secret      = ""
alpaca_api_key          = ""
alpaca_api_secret       = ""
firebase_project_id     = "cerberus-9d94f"
firebase_enabled        = true
firebase_auth_required  = true
firebase_signal_collection = "strategy_signals"
supabase_enabled        = true
matching_enabled        = true
strategy_internal_auth_enabled = true
strategy_internal_auth_token_ttl_seconds = 300
strategy_internal_auth_metadata_identity_url = "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/identity"
strategy_upstream_timeout_ms = 1800
strategy_upstream_health_timeout_ms = 1500
strategy_upstream_max_inflight = 64
strategy_upstream_queue_timeout_ms = 250
strategy_upstream_circuit_enabled = true
strategy_upstream_circuit_failure_threshold = 6
strategy_upstream_circuit_open_ms = 15000
redis_market_events_stream_enabled = true
redis_market_events_stream_key = "cerberus.market.events"
redis_market_events_stream_maxlen = 50000
redis_market_events_publish_legacy_pubsub = true
redis_order_events_stream_enabled = true
redis_order_events_stream_key = "cerberus.order.events"
redis_order_events_consumer_group = "gateway-orders"
redis_order_events_consumer_name = ""
redis_order_events_read_batch_size = 64
redis_order_events_read_block_ms = 3000
redis_order_events_pending_replay_count = 128
redis_order_events_batch_window_ms = 100
redis_order_events_max_retries_before_fallback = 6
redis_order_events_retry_backoff_ms = 200
redis_order_events_retry_backoff_max_ms = 5000
redis_order_events_reclaim_enabled = true
redis_order_events_reclaim_interval_ms = 5000
redis_order_events_reclaim_idle_ms = 30000
redis_order_events_reclaim_batch_size = 64
redis_order_events_max_delivery_attempts = 8
redis_order_events_poison_stream_key = "cerberus.order.events.poison"
redis_order_events_poison_stream_maxlen = 20000
redis_order_events_pending_warn_threshold = 2000
redis_order_events_lag_warn_threshold = 2000
market_stream_enabled = true
market_stream_consumer_group = "strategy-market"
market_stream_reclaim_enabled = true
market_stream_reclaim_interval_ms = 5000
market_stream_reclaim_idle_ms = 30000
market_stream_reclaim_batch_size = 64
market_stream_max_delivery_attempts = 8
market_stream_pending_warn_threshold = 2000
market_stream_lag_warn_threshold = 2000
market_stream_poison_stream_key = "cerberus.market.events.poison"
market_stream_poison_stream_maxlen = 20000
market_stream_legacy_pubsub_fallback = true
matching_grpc_max_pollers = 16
matching_grpc_min_pollers = 4
matching_grpc_num_cqs = 4
matching_execution_stream_limit = 500
matching_submit_latency_window_size = 1024
matching_max_inflight_requests = 1024
matching_inflight_acquire_timeout_ms = 30
cloud_run_gateway = {
  min_instance_count               = 1
  max_instance_count               = 30
  max_instance_request_concurrency = 80
  timeout_seconds                  = 900
  cpu                              = "1"
  memory                           = "1Gi"
  cpu_idle                         = false
  startup_cpu_boost                = true
}
cloud_run_strategy = {
  min_instance_count               = 1
  max_instance_count               = 20
  max_instance_request_concurrency = 20
  timeout_seconds                  = 300
  cpu                              = "2"
  memory                           = "2Gi"
  cpu_idle                         = false
  startup_cpu_boost                = true
}
cloud_run_matching = {
  min_instance_count               = 1
  max_instance_count               = 20
  max_instance_request_concurrency = 16
  timeout_seconds                  = 120
  cpu                              = "2"
  memory                           = "2Gi"
  cpu_idle                         = false
  startup_cpu_boost                = true
}

cors_allow_origins = "https://cerberus-9d94f.web.app,https://cerberus-9d94f.firebaseapp.com"

container_images = {
  gateway  = "asia-east2-docker.pkg.dev/cerberus-9d94f/cerberus/gateway:latest"
  strategy = "asia-east2-docker.pkg.dev/cerberus-9d94f/cerberus/strategy:latest"
  matching = "asia-east2-docker.pkg.dev/cerberus-9d94f/cerberus/matching:latest"
}
