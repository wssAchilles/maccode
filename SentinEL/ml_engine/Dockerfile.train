# ============================================================================
# SentinEL 多模态 Transformer 训练容器
# 用于 Vertex AI Hyperparameter Tuning Jobs
# ============================================================================
#
# 构建命令:
#   cd ml_engine
#   gcloud builds submit --config=cloudbuild.yaml .
#
# ============================================================================

# 使用 Python 3.11 官方镜像 (轻量级, 兼容性好)
# 对于 GPU 训练，Vertex AI 会自动提供 CUDA 环境
FROM python:3.11-slim

# 设置环境变量
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements.txt /app/requirements.txt

# 安装 PyTorch (CPU 版本用于构建，GPU 版本在运行时由 Vertex AI 提供)
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# 安装其他 Python 依赖
RUN pip install --no-cache-dir -r requirements.txt

# 复制 ml_engine 模块
# 注意: 构建上下文是 ml_engine/ 目录
COPY . /app/ml_engine/

# 设置 PYTHONPATH 确保模块可导入
ENV PYTHONPATH="/app:${PYTHONPATH}"

# 入口点: 运行多模态训练脚本
# Vertex AI HPT 会通过命令行参数传递超参数
ENTRYPOINT ["python", "-m", "ml_engine.training.train_multimodal"]

# 默认参数 (会被 HPT Job 覆盖)
CMD ["--help"]

