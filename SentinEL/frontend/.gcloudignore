# Ignore node_modules - Cloud Build will install dependencies
node_modules/

# Ignore build output - Cloud Build will rebuild
.next/
out/

# Ignore dev/test files
.env.local
.env*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore IDE and OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Ignore test coverage
coverage/

# Ignore git
.git/
.gitignore
